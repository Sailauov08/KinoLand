# TMDB credentials — https://www.themoviedb.org/settings/api
# Provide ONE of the two. The v4 "API Read Access Token" is preferred.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Comma-separated emails that receive the admin role when they register or sign in.
ADMIN_EMAILS=

# Optional: path of the SQLite database file (default: ./data/kino.db)
DATABASE_PATH=
