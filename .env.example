# Copy this file to .env.local and fill in your TMDB credential, then restart `npm run dev`.

# REQUIRED — TMDB "API Read Access Token" (the long v4 token starting with "eyJ").
# Get it at https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# Alternative to the token above: the short v3 "API Key". Set only one of the two.
TMDB_API_KEY=

# Optional — comma-separated emails that receive the admin role when they register or sign in.
ADMIN_EMAILS=

# Optional — path of the SQLite database file (default: ./data/kino.db)
DATABASE_PATH=
