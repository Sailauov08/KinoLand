# Copy to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

# REQUIRED — TMDB credential (one of the two). https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# REQUIRED in production — Supabase Postgres connection string.
# Supabase → Project → Connect → "Transaction pooler" (port 6543), e.g.
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Leave empty locally to use the embedded dev database (data/pglite).
DATABASE_URL=

# Optional — Supabase CA certificate (Database settings → SSL configuration → Download certificate),
# pasted as one line with 
 for newlines. When set, the server certificate is verified; otherwise the
# connection is encrypted without verification (libpq sslmode=require behaviour).
DATABASE_CA_CERT=

# Recommended in production — public site URL (Open Graph / social previews), e.g. https://kinoland.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional — time zone for daily statistics (default Asia/Almaty).
APP_TIMEZONE=Asia/Almaty

# Optional — PostHog product analytics, forwarded server-side only for visitors who accept the consent prompt.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional — server-only credentials so /admin/analytics can show PostHog numbers.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
