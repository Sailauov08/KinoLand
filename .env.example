# Copy to .env.local and fill in. Never commit .env.local.

# REQUIRED — TMDB credential (one of the two). https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Recommended in production — public base URL, used for Open Graph/social preview links.
NEXT_PUBLIC_SITE_URL=

# Optional — PostHog product analytics. Events are forwarded server-side ONLY for visitors who
# accept the consent prompt; no PostHog script or key is sent to browsers.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional — server-only credentials that let /admin/analytics show PostHog numbers.
# Create a personal API key with "query:read" scope. Never expose it client-side.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Optional — SQLite database file path (default: ./data/kino.db)
DATABASE_PATH=
